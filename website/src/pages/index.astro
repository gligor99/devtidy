---
import icon from '../assets/icon.svg?url'
import { DOWNLOADS, REPO, RULES, VERSION, describeCleanup } from '../lib/project'

const base = import.meta.env.BASE_URL
const docs = (path = '') => `${base}docs/${path}`
const title = 'DevTidy · Reclaim the disk space your dev tools ate'
const description =
  'DevTidy shows what Xcode, simulators, Android, Gradle, npm and friends store on your Mac, explains each item, and cleans it safely. Free and open source macOS app and CLI.'
const canonical = new URL(base, Astro.site).href

const features = [
  {
    title: 'Explains every item',
    body: 'Not just a folder and a size. What it is, what removing it costs you, and exactly how it will be removed.',
    icon: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm0 5v.01M11 12h1v5h1',
  },
  {
    title: 'Never leaves its lane',
    body: "Cleans only a rule's own paths. Never follows symlinks, never crosses mounts. Proven with property-based tests.",
    icon: 'M12 3 4 6v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V6l-8-3Zm-3.5 9 2.5 2.5L16 9',
  },
  {
    title: 'Honest sizes',
    body: 'Counts allocated blocks, not file length. Hard links counted once, so pnpm stores show what will really be freed.',
    icon: 'M4 19h16M7 16V9m5 7V5m5 11v-4',
  },
  {
    title: "Uses the tool's own cleanup",
    body: '`npm cache clean`, `pod cache clean`, `xcrun simctl` first. Deleting behind a tool’s back is the fallback, not the plan.',
    icon: 'M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.4-.6-.6-2.4 2.6-2.6Z',
  },
  {
    title: 'Tracks growth',
    body: 'Every scan is kept locally, so you can see that Gradle grew 4 GB since last week before your disk fills up.',
    icon: 'M3 17l6-6 4 4 8-8m0 0h-5m5 0v5',
  },
  {
    title: 'Never phones home',
    body: 'No telemetry, no analytics, no remote rules. Rules ship inside the binary and change only through a release.',
    icon: 'M3 3l18 18M10.6 5.1A10 10 0 0 1 21 12a10.6 10.6 0 0 1-2.5 3.4M6.3 6.3A10.6 10.6 0 0 0 3 12a10 10 0 0 0 13.7 5.7M9.9 9.9a3 3 0 0 0 4.2 4.2',
  },
]

const tools = [
  'Xcode DerivedData',
  'Archives',
  'iOS Simulators',
  'Device support',
  'CocoaPods',
  'Android SDK images',
  'AVDs',
  'Gradle',
  'npm',
  'Yarn',
  'pnpm',
  'Bun',
  'Electron',
  'Flutter / pub',
  'Cargo',
  'pip',
  'Homebrew',
]

const focused = RULES.find((r) => r.id === 'xcode.derived-data')!

const mockItems = [
  { name: 'Android emulator system images', eco: 'Android', size: '31.5 GB', safety: 'caution', delta: '' },
  { name: 'Simulator devices', eco: 'iOS / Xcode', size: '18.3 GB', safety: 'dangerous', delta: '' },
  { name: 'Xcode DerivedData', eco: 'iOS / Xcode', size: '18.2 GB', safety: 'safe', delta: '+3.1 GB since last scan' },
  { name: 'Gradle caches', eco: 'Android', size: '12.1 GB', safety: 'safe', delta: '+4.0 GB since last scan' },
  { name: 'npm cache', eco: 'JavaScript', size: '9.2 GB', safety: 'safe', delta: '' },
  { name: 'pnpm store', eco: 'JavaScript', size: '8.4 GB', safety: 'caution', delta: 'frees ~1.3 GB' },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <meta name="theme-color" content="#0B1412" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DevTidy" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(`${base}og.png`, Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: 'DevTidy',
        operatingSystem: 'macOS 12+',
        applicationCategory: 'DeveloperApplication',
        softwareVersion: VERSION,
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
        license: 'https://opensource.org/licenses/MIT',
        downloadUrl: DOWNLOADS.dmg,
      })}
    />
  </head>
  <body>
    <div class="bg" aria-hidden="true"></div>

    <header class="nav">
      <a class="brand" href={base}>
        <img src={icon} alt="" width="30" height="30" />
        <span>DevTidy</span>
      </a>
      <nav>
        <a href={docs()}>Docs</a>
        <a href={docs('cli/')}>CLI</a>
        <a href={docs('rules/')}>Rules</a>
        <a href={REPO} class="gh" aria-label="GitHub">
          <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"
            ><path
              fill="currentColor"
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
            ></path></svg
          >
        </a>
        <a class="btn btn-small" href={DOWNLOADS.dmg}>Download</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <a class="pill" href={`${REPO}/releases/tag/v${VERSION}`}>
          <span class="dot"></span> v{VERSION} is out · desktop app + CLI
        </a>
        <h1>
          Reclaim the disk space<br /><span class="grad">your dev tools ate.</span>
        </h1>
        <p class="lead">
          DevTidy shows what Xcode, simulators, Android, Gradle, npm and friends are storing on your Mac, explains
          what each item is, and cleans it without ever touching anything else.
        </p>
        <div class="ctas">
          <a class="btn btn-primary" href={DOWNLOADS.dmg}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
              ><path fill="currentColor" d="M12 3v11.2l4.3-4.3 1.4 1.4L12 17l-5.7-5.7 1.4-1.4 4.3 4.3V3h0ZM5 19h14v2H5z"
              ></path></svg
            >
            Download for macOS
          </a>
          <a class="btn btn-ghost" href={docs('install/')}>Install the CLI →</a>
        </div>
        <p class="fine">Free and open source · macOS 12+ · Apple Silicon and Intel · {RULES.length} built-in rules</p>

        <div class="window" role="img" aria-label="The DevTidy app showing developer caches by size and safety, with Xcode DerivedData selected and explained">
          <div class="win-side">
            <div class="lights"><i></i><i></i><i></i></div>
            <div class="win-brand"><img src={icon} alt="" width="22" height="22" /> DevTidy <small>v{VERSION}</small></div>
            <p class="win-nav active">Overview</p>
            <p class="win-label">Ecosystems</p>
            <p class="win-nav">Android <span>63.6 GB</span></p>
            <p class="win-nav">iOS / Xcode <span>38.0 GB</span></p>
            <p class="win-nav">JavaScript <span>19.7 GB</span></p>
            <p class="win-nav">Flutter <span>323 MB</span></p>
          </div>
          <div class="win-main">
            <div class="win-head">
              <div>
                <small>Can be reclaimed</small>
                <strong>98.7 GB <em>39.5 GB marked safe</em></strong>
              </div>
              <span class="win-btn">Rescan</span>
            </div>
            <div class="meter"><b style="width: 89%"></b><s style="left: 68%; width: 21%"></s></div>
            <ul>
              {
                mockItems.map((item) => (
                  <li
                    class:list={[
                      { checked: item.name === 'Xcode DerivedData' || item.name === 'Gradle caches' },
                      { focused: item.name === focused.name },
                    ]}
                  >
                    <span class="box" />
                    <span class="name">
                      {item.name}
                      <small>{item.eco}</small>
                    </span>
                    <span class={`chip ${item.safety}`}>{item.safety}</span>
                    <span class="size">
                      {item.size}
                      {item.delta && <small class={item.delta.startsWith('+') ? 'grew' : ''}>{item.delta}</small>}
                    </span>
                  </li>
                ))
              }
            </ul>
            <div class="win-foot"><span>Select all safe</span><span class="win-cta">Clean 2 · 21.3 GB</span></div>
          </div>
          <aside class="win-detail">
            <span class="chip safe">{focused.safety}</span>
            <h4>{focused.name}</h4>
            <p class="desc">{focused.description}</p>
            <dl>
              <dt>Size</dt>
              <dd>18.2 GB<small>15.1 GB 6 days ago</small></dd>
              <dt>After removal</dt>
              <dd>{focused.regen_note}</dd>
              <dt>Cost to regenerate</dt>
              <dd class="cap">{focused.regen_cost}</dd>
              <dt>How it is removed</dt>
              <dd>{describeCleanup(focused)}</dd>
              <dt>Quit first</dt>
              <dd>{focused.processes?.join(', ')}</dd>
              <dt>Location</dt>
              <dd class="path">
                <code>/Users/you/Library/Developer/Xcode/DerivedData</code>
                <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"
                  ><path
                    d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v2M3 7v10a2 2 0 0 0 2 2h6m6-4a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm2.5 5.5L21 22"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path></svg
                >
              </dd>
            </dl>
          </aside>
        </div>
      </section>

      <section class="tools" aria-label="Supported tools">
        <p>Knows where your tools hide their data</p>
        <div class="marquee">
          <div class="track">
            {[...tools, ...tools].map((t) => <span>{t}</span>)}
          </div>
        </div>
      </section>

      <section class="features">
        <h2>Built for developers who read the plan before they press the button.</h2>
        <div class="grid">
          {
            features.map((f) => (
              <article class="card">
                <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                  <path d={f.icon} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <h3>{f.title}</h3>
                <p set:html={f.body.replace(/`([^`]+)`/g, '<code>$1</code>')} />
              </article>
            ))
          }
        </div>
      </section>

      <section class="split">
        <div>
          <p class="eyebrow">CLI</p>
          <h2>Same engine in your terminal.</h2>
          <p>
            Scriptable, with a versioned JSON schema and stable exit codes. Put
            <code>devtidy scan --fail-above 50G</code> in a cron job or CI and get warned before the disk fills up.
          </p>
          <a class="link" href={docs('cli/')}>Read the CLI reference →</a>
        </div>
        <div class="term" aria-label="devtidy scan output">
          <div class="term-bar"><i></i><i></i><i></i><span>zsh</span></div>
          <pre><code><span class="p">$</span> devtidy scan -e android -e ios
<span class="m">Scanning 13 locations…</span>
Item                            Size      Safety
Android emulator system images  31.5 GB   <span class="c">caution</span>
Simulator devices               18.3 GB   <span class="d">dangerous</span>
Xcode DerivedData               18.2 GB   <span class="s">safe</span>
Gradle caches                   12.1 GB   <span class="s">safe</span>
Total 80.1 GB, reclaimable ~80.1 GB (30.3 GB marked safe).

<span class="p">$</span> devtidy clean --safe
<span class="m">…plan shown, confirmed</span>
  done     Xcode DerivedData
  done     Gradle caches
Freed <span class="s">30.1 GB</span> (measured on disk).</code></pre>
        </div>
      </section>

      <section class="safety">
        <p class="eyebrow">Safety model</p>
        <h2>Removal follows risk.</h2>
        <div class="tiers">
          <div class="tier">
            <span class="chip safe">safe</span>
            <h3>Deleted</h3>
            <p>Pure caches the tool rebuilds on its own. Space is freed immediately and measured.</p>
          </div>
          <div class="tier">
            <span class="chip caution">caution</span>
            <h3>Moved to the Trash</h3>
            <p>Rebuildable, but slow or with side effects. You can still put it back.</p>
          </div>
          <div class="tier">
            <span class="chip dangerous">dangerous</span>
            <h3>One at a time</h3>
            <p>Archives with dSYMs, simulators with app data. Never in bulk, and you type its id to confirm.</p>
          </div>
        </div>
        <a class="link" href={docs('safety/')}>How the guard works →</a>
      </section>

      <section class="final">
        <img src={icon} alt="" width="84" height="84" />
        <h2>Get your gigabytes back.</h2>
        <div class="ctas">
          <a class="btn btn-primary" href={DOWNLOADS.dmg}>Download for macOS</a>
          <a class="btn btn-ghost" href={REPO}>Star on GitHub</a>
        </div>
        <p class="fine">
          Not notarized yet: on first launch, right-click DevTidy and choose Open. <a href={docs('install/')}>Details</a>
        </p>
      </section>
    </main>

    <footer class="foot">
      <span>DevTidy · MIT OR Apache-2.0 · No telemetry</span>
      <span>
        <a href={docs()}>Docs</a>
        <a href={docs('changelog/')}>Changelog</a>
        <a href={`${REPO}/releases`}>Releases</a>
        <a href={REPO}>GitHub</a>
      </span>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #0b1412;
    --bg-2: #101c19;
    --line: rgb(255 255 255 / 0.08);
    --text: #ecfdf8;
    --muted: #9fb8b2;
    --faint: #6b8580;
    --teal: #14b8a6;
    --teal-2: #5eead4;
    --gold: #fcd34d;
    --safe: #2dd4a7;
    --caution: #f5b941;
    --dangerous: #f2685b;
    --radius: 14px;
    --font: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', system-ui, sans-serif;
    --mono: ui-monospace, 'SF Mono', 'JetBrains Mono', Menlo, monospace;
  }
  * {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font);
    -webkit-font-smoothing: antialiased;
    line-height: 1.55;
  }
  a {
    color: inherit;
  }
  code {
    font-family: var(--mono);
    font-size: 0.88em;
    background: rgb(255 255 255 / 0.06);
    border: 1px solid var(--line);
    padding: 0.08em 0.38em;
    border-radius: 6px;
  }
</style>

<style>
  .bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(60rem 40rem at 15% -10%, rgb(20 184 166 / 0.28), transparent 60%),
      radial-gradient(40rem 30rem at 100% 30%, rgb(252 211 77 / 0.07), transparent 60%),
      linear-gradient(var(--line) 1px, transparent 1px) 0 0 / 48px 48px,
      linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0 / 48px 48px;
    mask-image: radial-gradient(ellipse at 50% 0%, #000 40%, transparent 85%);
  }

  /* Nav */
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1160px;
    margin: 0 auto;
    padding: 14px 24px;
    backdrop-filter: blur(14px);
    background: rgb(11 20 18 / 0.6);
    border-bottom: 1px solid transparent;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  .brand img {
    border-radius: 22%;
  }
  .nav nav {
    display: flex;
    align-items: center;
    gap: 22px;
    font-size: 14px;
  }
  .nav nav a:not(.btn) {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s;
  }
  .nav nav a:not(.btn):hover {
    color: var(--text);
  }
  .gh {
    display: flex;
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-radius: 999px;
    padding: 12px 22px;
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    transition:
      transform 0.15s,
      box-shadow 0.15s,
      background 0.15s;
  }
  .btn:hover {
    transform: translateY(-1px);
  }
  .btn-primary {
    color: #04201c;
    background: linear-gradient(135deg, var(--teal-2), var(--teal));
    box-shadow:
      0 10px 30px -10px rgb(20 184 166 / 0.7),
      inset 0 1px 0 rgb(255 255 255 / 0.4);
  }
  .btn-ghost {
    border: 1px solid var(--line);
    background: rgb(255 255 255 / 0.03);
  }
  .btn-ghost:hover {
    background: rgb(255 255 255 / 0.07);
  }
  .btn-small {
    padding: 7px 14px;
    font-size: 13px;
    color: #04201c;
    background: var(--teal-2);
  }

  main {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 24px;
  }
  section {
    padding: 72px 0;
  }
  h1,
  h2,
  h3 {
    letter-spacing: -0.03em;
    line-height: 1.08;
    margin: 0;
  }
  h2 {
    font-size: clamp(28px, 4vw, 44px);
    text-wrap: balance;
  }
  .eyebrow {
    color: var(--teal-2);
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin: 0 0 10px;
  }
  .link {
    display: inline-block;
    margin-top: 18px;
    color: var(--teal-2);
    text-decoration: none;
    font-weight: 600;
  }
  .fine {
    color: var(--faint);
    font-size: 13px;
  }
  .fine a {
    color: var(--muted);
  }

  /* Hero */
  .hero {
    text-align: center;
    padding-top: 64px;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--muted);
    text-decoration: none;
    padding: 6px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.03);
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--safe);
    box-shadow: 0 0 10px var(--safe);
  }
  h1 {
    margin-top: 26px;
    font-size: clamp(40px, 7vw, 80px);
    font-weight: 800;
  }
  .grad {
    background: linear-gradient(100deg, var(--teal-2) 10%, var(--teal) 55%, var(--gold) 110%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .lead {
    max-width: 640px;
    margin: 22px auto 0;
    font-size: 19px;
    color: var(--muted);
  }
  .ctas {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 32px;
  }

  /* App window mockup */
  .window {
    display: flex;
    max-width: 1160px;
    margin: 56px auto 0;
    text-align: left;
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
    background: #0f1917;
    box-shadow:
      0 40px 120px -30px rgb(20 184 166 / 0.35),
      0 0 0 1px rgb(255 255 255 / 0.04) inset;
    font-size: 13px;
  }
  .win-side {
    width: 210px;
    flex-shrink: 0;
    padding: 14px 10px;
    background: #121e1b;
    border-right: 1px solid var(--line);
  }
  .lights {
    display: flex;
    gap: 7px;
    padding: 2px 6px 18px;
  }
  .lights i,
  .term-bar i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #ff5f57;
  }
  .lights i:nth-child(2),
  .term-bar i:nth-child(2) {
    background: #febc2e;
  }
  .lights i:nth-child(3),
  .term-bar i:nth-child(3) {
    background: #28c840;
  }
  .win-brand {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    padding: 0 6px 14px;
  }
  .win-brand img {
    border-radius: 22%;
  }
  .win-brand small {
    color: var(--faint);
    font-weight: 400;
  }
  .win-label {
    color: var(--faint);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 14px 8px 4px;
  }
  .win-nav {
    display: flex;
    justify-content: space-between;
    margin: 0;
    padding: 6px 8px;
    border-radius: 7px;
  }
  .win-nav span {
    color: var(--faint);
  }
  .win-nav.active {
    background: rgb(255 255 255 / 0.07);
    font-weight: 600;
  }
  .win-main {
    flex: 1;
    min-width: 0;
  }
  .window li.focused {
    background: rgb(255 255 255 / 0.07);
